{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Out-of-tree Debug build using the platform default generator",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-sanitizer",
      "displayName": "Linux sanitizers",
      "description": "Linux AddressSanitizer and UndefinedBehaviorSanitizer. Do not mix with coverage.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON",
        "ENABLE_COVERAGE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux coverage",
      "description": "Linux GCC/Clang coverage instrumentation. Do not mix with sanitizers.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON",
        "ENABLE_SANITIZERS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "linux-sanitizer",
      "configurePreset": "linux-sanitizer"
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-sanitizer",
      "configurePreset": "linux-sanitizer",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
